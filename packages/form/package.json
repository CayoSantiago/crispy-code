{
  "name": "@repo/form",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./utils": "./src/utils.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "imports": {
    "#*": [
      "./src/*",
