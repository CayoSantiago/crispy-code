{
  "name": "crispy-code",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:dev": "docker compose up",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:ping": "pnpm --filter @repo/db db:ping",
    "db:resolve-env": "pnpm --filter @repo/db db:resolve-env"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@repo/typescript-config": "workspace:*",
    "inngest-cli": "^1.43.0",
    "netlify-plugin-inngest": "^1.0.1",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
