# Local Docker Postgres (pnpm db:up). Dev-only credentials — do not use in production.
DATABASE_URL="postgresql://crispy:crispy@localhost:5432/crispy_code?schema=public"
# Neon production only. Direct (unpooled) URL for Prisma migrations. Local Docker does not need this.
# DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"
# Netlify Deploy Previews only (never commit real values):
# NEON_API_KEY=
# NEON_PROJECT_ID=

# Better Auth (required). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-change-me-use-openssl-rand-base64"
BETTER_AUTH_URL="http://localhost:3000"

# Resend (required to send). Local from-address only delivers to the Resend account email.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Crispy Code <onboarding@resend.dev>"

# Inngest. Local only: keep INNGEST_DEV=1. Never set this on Netlify.
# Cloud keys are required in production.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Optional. Required only once AI workflows exist. Copy into apps/web/.env.local.
# GEMINI_API_KEY=

# Optional OAuth. Callbacks:
#   {BETTER_AUTH_URL}/api/auth/callback/github
#   {BETTER_AUTH_URL}/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
